# App
BASE_URL="https://your-app-url.com"
LOGIN_PATH="/login"
LOGIN_USERNAME="your-login-username"
LOGIN_PASSWORD="your-login-password"
DASHBOARD_PATH="/dashboard"
# Optional direct URL to commercial queue (skips clicking nav)
# COMMERCIAL_QUEUE_PATH="/commercial-queue"

# SFTP Server Configuration
SFTP_HOST="your-sftp-server.com"
SFTP_PORT="22"
SFTP_USERNAME="your-sftp-username"
SFTP_PASSWORD="your-sftp-password"

# MongoDB
MONGODB_URI="mongodb://user:password@host:27017/?authSource=admin"
MONGODB_DB="your-database"
MONGODB_TASKS_COLLECTION="tasks"
MONGODB_SUBTASKS_COLLECTION="subTasks"
